# =====================================================
# DeyaRun - Root .gitignore
# =====================================================
# Security-focused gitignore covering all sensitive files
# across backend, frontend/web, frontend/Mobile
# Last Updated: 2025-11-01
# =====================================================

# =====================================================
# 🔐 CRITICAL: ENVIRONMENT & SECRETS
# =====================================================
# NEVER commit these files - contain API keys, passwords, tokens

# Environment files (all directories)
**/.env
**/.env.local
**/.env.production
**/.env.production.local
**/.env.development
**/.env.development.local
**/.env.test
**/.env.test.local
**/.env.*.local
**/.env.coolify
**/.env.vercel

# Keep example files for reference
!**/.env.example
!**/.env.local.example

# Backend specific environment files
backend/env-Railway*
backend/env-Railway-v2-MongoDB
backend/.env
backend/.env*
!backend/.env.example

# =====================================================
# 🔥 FIREBASE CREDENTIALS
# =====================================================
# Server-side Firebase credentials (SENSITIVE)
**/running-academy-*.json
**/firebase-service-account*.json
**/firebase-adminsdk-*.json
**/*firebase*admin*.json

# Client-side Firebase configs (these are safe to commit)
# **/google-services.json        # Android - public config
# **/GoogleService-Info.plist    # iOS - public config

# Google OAuth credentials (SENSITIVE)
**/client_secret_*.json
**/oauth-credentials.json

# =====================================================
# 🔑 CERTIFICATES & KEYS
# =====================================================
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.jks
**/*.keystore
**/*.mobileprovision
**/*.cer
**/*.crt
**/privatekey.pem
**/certificate.pem

# =====================================================
# 📦 DEPENDENCIES
# =====================================================
# Node modules (all directories)
**/node_modules/
node_modules/

# Gradle dependencies (mobile)
**/.gradle/
**/gradle/wrapper/gradle-wrapper.jar

# =====================================================
# 🏗️ BUILD OUTPUTS
# =====================================================
# Backend build
backend/dist/
backend/build/

# Frontend web build (Next.js)
frontend/web/.next/
frontend/web/out/
frontend/web/build/
frontend/web/dist/
frontend/web/web-build/

# Mobile build outputs (Kotlin/Android)
frontend/Mobile/.gradle/
frontend/Mobile/build/
frontend/Mobile/app/build/
frontend/Mobile/app/release/
frontend/Mobile/local.properties
frontend/Mobile/.cxx/
frontend/Mobile/captures/

# Expo legacy (if exists)
frontend/archive/mobile_legacy/.expo/
frontend/archive/mobile_legacy/expo-env.d.ts
frontend/archive/mobile_legacy/.gradle/
frontend/archive/mobile_legacy/android/build/
frontend/archive/mobile_legacy/android/app/build/
frontend/archive/mobile_legacy/android/app/.cxx/

# =====================================================
# 📝 LOGS
# =====================================================
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/*.log
**/hs_err_pid*.log

# Application logs
**/logs/
**/log/
**/*.log.*

# =====================================================
# 🧪 TESTING
# =====================================================
**/coverage/
**/test-results/
**/playwright-report/
**/.nyc_output/
**/__coverage__/

# =====================================================
# 🗄️ DATABASES
# =====================================================
**/*.db
**/*.sqlite
**/*.sqlite3
**/prisma/dev.db
**/database.db

# =====================================================
# 📤 UPLOADS & TEMPORARY FILES
# =====================================================
**/uploads/
**/tmp/
**/temp/
**/.tmp/
nul

# =====================================================
# 💾 BACKUPS
# =====================================================
# Use git history instead of backup files
**/*.backup
**/*.backup_sensitive
**/*backup_sensitive*
**/*.bak
**/*.old
**/*.orig
**/*.swp
**/*.swo
**/.#*

# =====================================================
# 🖥️ OS FILES
# =====================================================
# macOS
**/.DS_Store
**/.AppleDouble
**/.LSOverride
**/._*

# Windows
**/Thumbs.db
**/Desktop.ini
**/$RECYCLE.BIN/

# Linux
**/*~
**/.directory
**/.Trash-*/

# =====================================================
# 🛠️ IDE & EDITORS
# =====================================================
# VSCode
**/.vscode/
**/.vscode-test/
**/*.code-workspace

# IntelliJ IDEA
**/.idea/
**/*.iml
**/*.ipr
**/*.iws
**/out/

# Android Studio
frontend/Mobile/.idea/
frontend/Mobile/*.iml

# Eclipse
**/.project
**/.classpath
**/.settings/

# Vim
**/*.swp
**/*.swo
**/*.swn

# Emacs
**/*~
**/#*#
**/.#*

# Sublime Text
**/*.sublime-project
**/*.sublime-workspace

# =====================================================
# 📱 MOBILE SPECIFIC
# =====================================================
# Android
frontend/Mobile/local.properties
frontend/Mobile/.gradle/
frontend/Mobile/.idea/
frontend/Mobile/captures/
frontend/Mobile/app/google-services.json.backup

# Fastlane (if used for deployment)
frontend/Mobile/fastlane/report.xml
frontend/Mobile/fastlane/Preview.html
frontend/Mobile/fastlane/screenshots
frontend/Mobile/fastlane/test_output

# =====================================================
# 🚀 DEPLOYMENT
# =====================================================
**/.vercel
**/railway.json
**/.coolify/
**/deployment-keys/

# Sentry
**/.env.sentry-build-plugin
**/sentry.properties

# =====================================================
# 📊 MONITORING & ANALYTICS
# =====================================================
# Sentry source maps (optional - can commit if needed)
# **/*.map
# **/.sentryclirc

# =====================================================
# 🧹 CLEANUP ARTIFACTS
# =====================================================
# Files from cleanup operations
backend/CLEANUP_INSTRUCTIONS.md.backup
backend/src-duplicate/
**/*-duplicate/
**/*-old/
**/*-backup/

# =====================================================
# 📄 DOCUMENTATION ARCHIVES
# =====================================================
docs/archive/
BRAIN/archive/
**/*-archive/

# =====================================================
# ⚙️ CONFIGURATION OVERRIDES
# =====================================================
# Local configuration overrides (keep examples)
**/config.local.js
**/config.local.json
!**/config.example.js
!**/config.example.json

# =====================================================
# 🔬 DEVELOPMENT TOOLS
# =====================================================
# Webpack
**/.cache/
**/.webpack/

# Parcel
**/.parcel-cache/

# Turbo
**/.turbo/

# TypeScript
**/*.tsbuildinfo

# ESLint
**/.eslintcache

# Stylelint
**/.stylelintcache

# =====================================================
# 📦 PACKAGE MANAGER LOCKS (Optional)
# =====================================================
# Uncomment if you want to ignore lock files
# (NOT recommended - lock files ensure consistent dependencies)
# **/package-lock.json
# **/yarn.lock
# **/pnpm-lock.yaml

# =====================================================
# 🎯 PROJECT SPECIFIC
# =====================================================
# Strava/Google Fit tokens (should be in database, not files)
**/strava-tokens.json
**/google-fit-tokens.json
**/oauth-tokens.json

# API keys file (should use .env instead)
**/api-keys.json
**/secrets.json
**/credentials.json

# Testing data with sensitive info
**/test-data-production.json
**/real-user-data.json

# =====================================================
# 🚫 NEVER COMMIT - SECURITY CRITICAL
# =====================================================
# Double-check these patterns
**/*secret*
**/*private*
**/*credential*
**/*password*
!**/*password-utils*  # Allow password utility files
!**/*secret-scanning*  # Allow security tools

# =====================================================
# ✅ EXCEPTIONS - SAFE TO COMMIT
# =====================================================
# These files are intentionally tracked
!README.md
!CLAUDE.md
!.gitignore
!.gitattributes
!**/.gitkeep
!**/.env.example
!**/config.example.*
!**/sample-*.json
!**/template-*.json

# =====================================================
# 📋 NOTES
# =====================================================
# If you accidentally committed sensitive data:
# 1. Remove from git history: git filter-branch or BFG Repo-Cleaner
# 2. Rotate all exposed credentials immediately
# 3. Review .gitignore and add missing patterns
# 4. Force push to remote (coordinate with team)
#
# To check what's tracked: git ls-files
# To check what's ignored: git status --ignored
# To scan for secrets: git-secrets or truffleHog
# =====================================================
