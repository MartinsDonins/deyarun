# =====================================================
# DEYARUN WEB FRONTEND - PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env.local and replace placeholder values
# ⚠️ SECURITY WARNING: Never commit real credentials to git!
# 
# Last Updated: 2025-01-19
# Version: 1.13.7
# =====================================================

# =====================================================
# 🌐 API CONFIGURATION
# =====================================================
# Production API endpoint (Can be shared - not sensitive)
NEXT_PUBLIC_API_URL=https://api.deyarun.com

# =====================================================
# 🗺️ GOOGLE SERVICES
# =====================================================
# Google Maps API Key - Get from: https://console.cloud.google.com/
# Enable APIs: Maps JavaScript API, Geocoding API, Places API
# Restrict key to domains: *.deyarun.com, deyarun.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=[YOUR_GOOGLE_MAPS_API_KEY]

# Google Analytics 4 - Get from: https://analytics.google.com/
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-[YOUR_MEASUREMENT_ID]

# =====================================================
# 🔥 FIREBASE CONFIGURATION (Client-side)
# =====================================================
# Get from: Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=[YOUR_FIREBASE_API_KEY]
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=[YOUR_PROJECT].firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=[YOUR_PROJECT_ID]
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=[YOUR_PROJECT].appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=[YOUR_SENDER_ID]
NEXT_PUBLIC_FIREBASE_APP_ID=1:[YOUR_SENDER_ID]:web:[YOUR_APP_ID]
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-[YOUR_MEASUREMENT_ID]

# =====================================================
# 📊 MONITORING & ANALYTICS
# =====================================================
# LogRocket Session Recording - Get from: https://app.logrocket.com/
NEXT_PUBLIC_LOGROCKET_APP_ID=[YOUR_LOGROCKET_APP_ID]

# Sentry Error Tracking - Get from: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=[YOUR_SENTRY_DSN]
SENTRY_AUTH_TOKEN=[YOUR_SENTRY_AUTH_TOKEN]
SENTRY_ORG=[YOUR_SENTRY_ORG]
SENTRY_PROJECT=deyarun-web

# =====================================================
# 💳 PAYMENT PROCESSING (MIGRATED TO EVERYPAY)
# =====================================================
# DEPRECATED: Stripe integration replaced with SEB EveryPay
# Previous: NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=[YOUR_STRIPE_PUBLISHABLE_KEY]
# 
# EveryPay Configuration - Get from: https://support.ecommerce.sebgroup.com/
# Contact: support@every-pay.com for Sandbox account setup
NEXT_PUBLIC_EVERYPAY_PUBLISHABLE_KEY_PROD=[YOUR_EVERYPAY_PROD_KEY]
NEXT_PUBLIC_EVERYPAY_PUBLISHABLE_KEY_SANDBOX=[YOUR_EVERYPAY_SANDBOX_KEY]

# =====================================================
# 🏃 FITNESS INTEGRATIONS
# =====================================================
# Strava OAuth - Get from: https://www.strava.com/settings/api
NEXT_PUBLIC_STRAVA_CLIENT_ID=[YOUR_STRAVA_CLIENT_ID]
NEXT_PUBLIC_STRAVA_REDIRECT_URI=https://deyarun.com/strava/callback

# =====================================================
# 🌍 ENVIRONMENT SETTINGS
# =====================================================
NODE_ENV=production

# Build settings
NEXT_TELEMETRY_DISABLED=1

# =====================================================
# 🎨 FEATURE FLAGS
# =====================================================
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SENTRY=true
NEXT_PUBLIC_ENABLE_LOGROCKET=true
NEXT_PUBLIC_ENABLE_PWA=true

# =====================================================
# 📱 PROGRESSIVE WEB APP
# =====================================================
# PWA configuration (Can be shared)
NEXT_PUBLIC_APP_NAME=DeyaRun
NEXT_PUBLIC_APP_SHORT_NAME=DeyaRun
NEXT_PUBLIC_APP_DESCRIPTION=Professional Running Training Platform

# =====================================================
# 🌍 LOCALIZATION
# =====================================================
# Default language
NEXT_PUBLIC_DEFAULT_LOCALE=lv
NEXT_PUBLIC_AVAILABLE_LOCALES=lv,en,ru

# =====================================================
# 🔗 SOCIAL MEDIA (Can be shared - not sensitive)
# =====================================================
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/deyarun
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/deyarun
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/deyarun

# =====================================================
# 📞 CONTACT INFO (Can be shared - not sensitive)
# =====================================================
NEXT_PUBLIC_SUPPORT_EMAIL=support@deyarun.com
NEXT_PUBLIC_CONTACT_PHONE=+371 20000000

# =====================================================
# 🚀 DEPLOYMENT (Coolify - Optional)
# =====================================================
# Only needed for admin deployment monitoring
# Get from: Coolify dashboard > Settings > API Tokens
NEXT_PUBLIC_COOLIFY_API_URL=https://coolify.runacademy.lv/api/v1
NEXT_PUBLIC_COOLIFY_API_TOKEN=[YOUR_COOLIFY_API_TOKEN]
NEXT_PUBLIC_COOLIFY_API_KEY=[YOUR_COOLIFY_API_KEY]