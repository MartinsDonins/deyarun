# =====================================================
# DEYARUN BACKEND - PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================
# Copy this file to .env and replace placeholder values
# ⚠️ SECURITY WARNING: Never commit real credentials to git!
# 
# Last Updated: 2025-01-19
# Version: 1.13.7
# =====================================================

# =====================================================
# 💾 DATABASE CONFIGURATION
# =====================================================
# MongoDB Atlas - Primary data storage for all application data
# Get from: https://cloud.mongodb.com/
MONGODB_URI="mongodb+srv://[USERNAME]:[PASSWORD]@[CLUSTER].mongodb.net/runacademy_production?retryWrites=true&w=majority"
MONGODB_URL="mongodb+srv://[USERNAME]:[PASSWORD]@[CLUSTER].mongodb.net/runacademy_production?retryWrites=true&w=majority"

# =====================================================
# 🔐 AUTHENTICATION & SECURITY
# =====================================================
# Generate strong keys: openssl rand -hex 64
JWT_SECRET="[GENERATE_STRONG_SECRET_KEY_64_CHARS_MIN]"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="[GENERATE_STRONG_SESSION_SECRET_64_CHARS_MIN]"
BCRYPT_ROUNDS=12

# =====================================================
# 🔥 FIREBASE CONFIGURATION (Mobile Push Notifications)
# =====================================================
# Get from: Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID="[YOUR_FIREBASE_PROJECT_ID]"
FIREBASE_PRIVATE_KEY_ID="[YOUR_FIREBASE_PRIVATE_KEY_ID]"
FIREBASE_PRIVATE_KEY="[YOUR_FIREBASE_PRIVATE_KEY]"
FIREBASE_CLIENT_EMAIL="[YOUR_FIREBASE_CLIENT_EMAIL]"
FIREBASE_CLIENT_ID="[YOUR_FIREBASE_CLIENT_ID]"
FIREBASE_AUTH_URI="https://accounts.google.com/o/oauth2/auth"
FIREBASE_TOKEN_URI="https://oauth2.googleapis.com/token"
FIREBASE_AUTH_PROVIDER_X509_CERT_URL="https://www.googleapis.com/oauth2/v1/certs"
FIREBASE_CLIENT_X509_CERT_URL="[YOUR_FIREBASE_CLIENT_X509_CERT_URL]"
FIREBASE_UNIVERSE_DOMAIN="googleapis.com"

# =====================================================
# 🌐 SERVER CONFIGURATION
# =====================================================
NODE_ENV="production"
PORT=3001

# PRODUCTION DOMAINS (Can be shared - not sensitive)
# These are the actual production domains for DeyaRun
CORS_ORIGIN="https://deyarun.com,https://www.deyarun.com,https://api.deyarun.com"
API_BASE_URL="https://api.deyarun.com"
FRONTEND_URL="https://deyarun.com"

# =====================================================
# 📧 EMAIL CONFIGURATION (SendGrid)
# =====================================================
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="[YOUR_SENDGRID_API_KEY]"

# Production email settings (Can be shared)
FROM_EMAIL="noreply@deyarun.com"
FROM_NAME="DeyaRun"
ADMIN_EMAIL="support@deyarun.com"

# =====================================================
# 🗺️ GOOGLE SERVICES
# =====================================================
# Google Maps API - Get from: https://console.cloud.google.com/
# Enable APIs: Maps JavaScript API, Geocoding API, Places API
GOOGLE_MAPS_API_KEY="[YOUR_GOOGLE_MAPS_API_KEY]"
MAPS_API_KEY="[YOUR_GOOGLE_MAPS_API_KEY]"

# Google OAuth 2.0 (for Google Authentication)
# Get from: https://console.cloud.google.com/apis/credentials
# Required Authorized Redirect URIs in Google Cloud Console:
#   - https://api.deyarun.com/api/auth/google/callback (Google Auth - MUST ADD!)
#   - https://api.deyarun.com/api/google-fit/callback (Google Fit - MUST ADD!)
#
# Configuration:
#   - Backend ALWAYS uses production URLs
#   - No development/production separation - production-only mode
#   - GOOGLE_REDIRECT_URI is for Google Auth (optional, auto-detected)
#   - GOOGLE_FIT_REDIRECT_URI is for Google Fit (optional, defaults to callback URL)
GOOGLE_CLIENT_ID="[YOUR_GOOGLE_CLIENT_ID]"
GOOGLE_CLIENT_SECRET="[YOUR_GOOGLE_CLIENT_SECRET]"
# GOOGLE_REDIRECT_URI="https://api.deyarun.com/api/auth/google/callback" # Optional - Google Auth callback
# GOOGLE_FIT_REDIRECT_URI="https://api.deyarun.com/api/google-fit/callback" # Optional - Google Fit callback
#
# Google Fit Integration:
# - Uses same GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET as Google Auth
# - Requires separate callback URL: /api/google-fit/callback
# - Scopes: fitness.activity.read, fitness.body.read, fitness.location.read, fitness.nutrition.read
# - Must add test users in Google Cloud Console (OAuth consent screen) during testing

# =====================================================
# 🤖 AI SERVICES
# =====================================================
# OpenAI API - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="[YOUR_OPENAI_API_KEY]"
OPENAI_API_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4"

# =====================================================
# 🏃 FITNESS INTEGRATIONS
# =====================================================
# Strava API - Get from: https://www.strava.com/settings/api
STRAVA_CLIENT_ID="[YOUR_STRAVA_CLIENT_ID]"
STRAVA_CLIENT_SECRET="[YOUR_STRAVA_CLIENT_SECRET]"
STRAVA_VERIFY_TOKEN="[GENERATE_RANDOM_TOKEN]"
STRAVA_WEBHOOK_CALLBACK_URL="https://api.deyarun.com/api/strava/webhook"
STRAVA_REDIRECT_URI="https://api.deyarun.com/api/strava/callback"

# =====================================================
# 📊 MONITORING & ANALYTICS
# =====================================================
# Sentry Error Tracking - Get from: https://sentry.io/
SENTRY_DSN="[YOUR_SENTRY_DSN]"
SENTRY_AUTH_TOKEN="[YOUR_SENTRY_AUTH_TOKEN]"
SENTRY_ORG="[YOUR_SENTRY_ORG]"
SENTRY_PROJECT="deyarun-backend"

# LogRocket Session Recording - Get from: https://app.logrocket.com/
LOGROCKET_APP_ID="[YOUR_LOGROCKET_APP_ID]"

# =====================================================
# ⚙️ API CONFIGURATION
# =====================================================
# Rate Limiting (Production values)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_PATH="./uploads"

# Logging
LOG_LEVEL="info"  # Options: error, warn, info, debug

# =====================================================
# 🌤️ EXTERNAL APIS (Optional)
# =====================================================
# Weather API - Get from: https://openweathermap.org/api
WEATHER_API_KEY="[YOUR_OPENWEATHER_API_KEY]"

# =====================================================
# 💳 PAYMENT PROCESSING (Optional)
# =====================================================
# Stripe - Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="[YOUR_STRIPE_SECRET_KEY]"
STRIPE_WEBHOOK_SECRET="[YOUR_STRIPE_WEBHOOK_SECRET]"

# =====================================================
# 🚀 DEPLOYMENT (Coolify)
# =====================================================
# Only needed if using Coolify API for deployments
COOLIFY_API_URL="https://coolify.yourdomain.com/api/v1"
COOLIFY_API_TOKEN="[YOUR_COOLIFY_API_TOKEN]"
COOLIFY_API_KEY="[YOUR_COOLIFY_API_KEY]"
COOLIFY_BACKEND_APP_ID="[YOUR_BACKEND_APP_UUID]"
COOLIFY_BACKEND_RESOURCE_ID="[YOUR_BACKEND_RESOURCE_UUID]"
COOLIFY_FRONTEND_RESOURCE_ID="[YOUR_FRONTEND_RESOURCE_UUID]"
COOLIFY_BASE_URL="https://coolify.yourdomain.com"
COOLIFY_SERVER_ID="[YOUR_SERVER_ID]"
COOLIFY_ENVIRONMENT="production"

# Coolify API Endpoints (auto-constructed if not provided)
# COOLIFY_API_SERVERS_URL="${COOLIFY_BASE_URL}/api/v1/servers"
# COOLIFY_API_APPLICATIONS_URL="${COOLIFY_BASE_URL}/api/v1/applications"
# COOLIFY_API_DEPLOYMENTS_URL="${COOLIFY_BASE_URL}/api/v1/deployments"

# =====================================================
# 📱 NOTIFICATIONS & WEBHOOKS (Optional)
# =====================================================
# Discord Webhook - For deployment notifications
DISCORD_WEBHOOK_URL="[YOUR_DISCORD_WEBHOOK_URL]"

# Slack Webhook - For deployment notifications
SLACK_WEBHOOK_URL="[YOUR_SLACK_WEBHOOK_URL]"

# PagerDuty Integration - For critical alerts
PAGERDUTY_INTEGRATION_KEY="[YOUR_PAGERDUTY_INTEGRATION_KEY]"

# =====================================================
# 🔧 OPTIONAL DEVELOPMENT VARIABLES
# =====================================================
# These are typically not needed in production

# SMTP Configuration (alternative to SendGrid)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="[YOUR_SMTP_EMAIL]"
# SMTP_PASSWORD="[YOUR_SMTP_PASSWORD]"

# Admin User Creation (first-time setup only)
# ADMIN_EMAIL="admin@deyarun.com"
# ADMIN_PASSWORD="[STRONG_ADMIN_PASSWORD]"
# ADMIN_FIRSTNAME="Admin"
# ADMIN_LASTNAME="User"

# Analytics Toggle
# ANALYTICS_ENABLED=true

# API Rate Limiting Override
# RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# Allowed domains for CORS (production auto-detects)
# ALLOWED_DOMAINS="deyarun.com,www.deyarun.com"