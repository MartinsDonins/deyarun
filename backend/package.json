{
  "name": "deyarun-backend",
  "version": "1.17.124",
  "description": "DeyaRun Backend - MongoDB + Firebase Architecture",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "dev": "set NODE_ENV=development && node server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint . --ext .js --ignore-pattern node_modules/ --ignore-pattern tests/",
    "lint:fix": "eslint . --ext .js --fix --ignore-pattern node_modules/ --ignore-pattern tests/",
    "drop-indexes": "node scripts/dropUniqueIndexes.js",
    "migrate": "node scripts/migrateUsersToMongoDB.js --force",
    "seed:subscriptions": "node scripts/seedSubscriptionPlansMongoDB.js",
    "test-production": "node test-production-backend.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.5",
    "@sentry/node": "^10.0.0",
    "@sentry/profiling-node": "^10.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "express-validator": "^7.0.1",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^137.1.0",
    "helmet": "^7.1.0",
    "js-yaml": "^4.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^6.18.0",
    "mongoose": "^7.6.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "openai": "^5.12.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.17.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
